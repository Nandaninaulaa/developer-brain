# --- Django ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-real-secret-in-any-deployed-environment
DEBUG=True
# Comma-separated. For local dev this can stay empty (defaults to localhost).
# For a cloud deploy, set this to your actual domain, e.g.:
# ALLOWED_HOSTS=devbrain.onrender.com
ALLOWED_HOSTS=
# Only needed once you're behind HTTPS on a real domain (admin/ingest POSTs
# will 403 without it): CSRF_TRUSTED_ORIGINS=https://devbrain.onrender.com
CSRF_TRUSTED_ORIGINS=
# Leave unset to use local SQLite. Set to a Postgres URL for production
# persistence (Render/Railway both offer a free Postgres add-on):
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=

# --- Paths ---
# CHROMA_DIR=./data/chroma

# --- Embeddings ---
# "local" uses fastembed (free, no API key needed, no torch)
# "openai" uses OpenAI's embedding API (needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OPENAI_API_KEY=sk-...

# --- LLM (for Q&A and Flashcards) ---
LLM_PROVIDER=none
# LLM_MODEL=gpt-4o-mini

# --- Knowledge Graph (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devbrain123
